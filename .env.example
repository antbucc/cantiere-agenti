# Porta e indirizzo di ascolto (0.0.0.0 = raggiungibile dalla rete locale dell'aula)
PORT=3000
HOST=0.0.0.0

# Codice del corso per gli studenti e codice docente per l'amministrazione.
# Sceglieteli voi: non vengono mai inviati al browser.
CODICE_CORSO=scegliete-un-codice-corso
CODICE_DOCENTE=scegliete-un-codice-docente

# File SQLite (facoltativo; predefinito ./data/cantiere.sqlite)
# DB_FILE=./data/cantiere.sqlite

# --- LLM open (facoltativo) --------------------------------------------------
# Qualsiasi endpoint compatibile OpenAI. Consigliato: Ollama in locale (modelli open).
#   ollama pull qwen2.5:14b      (ottimo in italiano, ~9 GB, serve un portatile con 16+ GB)
#   ollama pull llama3.1:8b      (più leggero, ~5 GB)
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL=qwen2.5:14b
# AI_API_KEY=
# AI_TIMEOUT_MS=90000

# Claude (Anthropic) per la Guida socratica: basta la chiave. Ha la precedenza su Ollama.
# I testi della guida (scenario, campo, conversazione) vengono inviati ad Anthropic.
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low                 # low | medium | high: più alto = più ragionamento, più lento e costoso
# SOCRATICO_PROVIDER=openai         # per forzare Ollama anche se c'è ANTHROPIC_API_KEY

# Ollama dentro l'app (comodo su Railway): avvia Ollama, scarica il modello e si collega da solo.
# MODELLO_INTEGRATO=qwen2.5:7b

# Guida socratica (attiva se AI_BASE_URL è impostato). Si può usare un modello diverso.
# SOCRATICO=on
# SOCRATICO_MODEL=qwen2.5:14b
# SOCRATICO_PROFILO=completo        # leggero per modelli piccoli su CPU (es. Ollama su Railway)
# SOCRATICO_TEMPERATURE=0.3
# SOCRATICO_MAX_TOKENS=450

# "Bozza con AI" su personas e user stories: mettete off per un corso tutto socratico.
# BOZZE_AI=on

# --- PDF (facoltativo) ---------------------------------------------------------
# Il PDF si compila sul server se è installata TeX Live (latexmk). Altrimenti: progetto Overleaf.
# PDF=on
# LATEX_ENGINE=pdflatex
# PDF_TIMEOUT_MS=180000
